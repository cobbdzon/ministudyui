PORT=3000

PUID=1000
PGID=1000

# External origin, e.g. https://study.example.com. Set this when a TLS
# reverse proxy fronts the app: its host is added to the allow-list and
# Secure cookies + HSTS are enabled. Leave empty for http://localhost.
PUBLIC_ORIGIN=

# Extra Host header values to accept, comma-separated (LAN IP, tailnet name,
# domain). The PUBLIC_ORIGIN host is added automatically.
# Example: ALLOWED_HOSTS=192.168.1.10:3000,study.tailnet.ts.net
ALLOWED_HOSTS=

# Set to 1 only when a reverse proxy in front overwrites X-Forwarded-For.
TRUST_PROXY=0

# Sliding session idle TTL in minutes. Sessions are memory-only, so a restart
# logs everyone out.
SESSION_TTL_MINUTES=720

# Per-user database size cap (MB), open user-DB handle cap, backups retained.
MAX_USER_DB_MB=512
MAX_OPEN_USER_DBS=32
BACKUP_KEEP=14

# BIND_HOST=0.0.0.0

# Only used by `bun run seed:demo`; the default demo passphrase is insecure.
# DEMO_PASSPHRASE=change-me
