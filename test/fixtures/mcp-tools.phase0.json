  {
    "name": "question_delete",
    "description": "Delete questions by id and renumber the remaining ones",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "question_ids": {
          "minItems": 1,
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "renumber": {
          "default": true,
          "type": "boolean"
        }
      },
      "required": [
        "question_ids",
        "renumber"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "question_update",
    "description": "Edit existing questions in bulk by id; only provided fields change",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "questions": {
          "minItems": 1,
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "question_id": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "type": {
                "type": "string",
                "enum": [
                  "mcq",
                  "multi",
                  "numeric",
                  "short",
                  "latex"
                ]
              },
              "position": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "prompt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "explanation": {
                "type": "string",
                "maxLength": 4000
              },
              "points": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 100
              },
              "choices": {
                "minItems": 2,
                "maxItems": 8,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z0-9_]{1,16}$"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1000
                    }
                  },
                  "required": [
                    "id",
                    "text"
                  ],
                  "additionalProperties": false
                }
              },
              "correct": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                ]
              },
              "value": {
                "type": "number"
              },
              "tolerance": {
                "type": "number",
                "minimum": 0
              },
              "tolerance_type": {
                "type": "string",
                "enum": [
                  "abs",
                  "rel"
                ]
              },
              "unit": {
                "type": "string",
                "maxLength": 20
              },
              "reference": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "rubric": {
                "type": "string",
                "maxLength": 2000
              }
            },
            "required": [
              "question_id"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "questions"
      ],
      "additionalProperties": false
    }
  },
