[
  {
    "name": "answer_grade",
    "description": "Grade an answer",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "answer_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "points": {
          "type": "number",
          "minimum": 0
        },
        "feedback": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      },
      "required": [
        "answer_id",
        "points",
        "feedback"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "attempt_list",
    "description": "List attempts",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "in_progress",
            "submitted",
            "graded"
          ]
        },
        "quiz_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "limit": {
          "default": 20,
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "limit"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "attempts_pending_grading",
    "description": "Pending grading",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "limit": {
          "default": 20,
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        }
      },
      "required": [
        "limit"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "card_add",
    "description": "Add cards",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "deck": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          ]
        },
        "cards": {
          "minItems": 1,
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "front": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "back": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "tags": {
                "maxItems": 10,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                }
              }
            },
            "required": [
              "front",
              "back"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "deck",
        "cards"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "card_delete",
    "description": "Delete cards",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "card_ids": {
          "minItems": 1,
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        }
      },
      "required": [
        "card_ids"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "card_schedule",
    "description": "Override a card due time (shift by minutes and/or make due now) and toggle whether it is ignored in reviews",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "card_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "adjust_minutes": {
          "type": "integer",
          "minimum": -10000,
          "maximum": 10000
        },
        "due_now": {
          "type": "boolean"
        },
        "ignored": {
          "type": "boolean"
        }
      },
      "required": [
        "card_id"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "card_search",
    "description": "Search cards",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "maxLength": 200
        },
        "deck": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          ]
        },
        "tag": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "enum": [
            "user",
            "ai",
            "import"
          ]
        },
        "limit": {
          "default": 20,
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "offset": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "limit",
        "offset"
      ],
      "additionalProperties": false
    }
  },
