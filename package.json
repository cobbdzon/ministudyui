{
  "name": "ministudyui",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "assets": "bun scripts/build-assets.ts",
    "start": "bun run assets && bun src/http/server.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "seed": "bun scripts/seed.ts",
    "seed:demo": "bun scripts/seed-demo.ts",
    "user": "bun scripts/user.ts",
    "backup": "bun scripts/backup.ts",
    "migrate:legacy": "bun scripts/migrate-legacy.ts",
    "sass": "sass --watch web/scss:web/css --no-source-map",
    "dev": "bun run assets && (bun --watch src/http/server.ts & bun run sass)"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@resvg/resvg-js": "^2.6.2",
    "hono": "^4.13.23",
    "katex": "^0.19.1",
    "marked": "^18.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "@types/node": "^26.6.11",
    "playwright": "^1.65.1",
    "sass": "^1.108.2",
    "typescript": "^7.0.2"
  }
}
